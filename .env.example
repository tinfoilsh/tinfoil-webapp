# Clerk Authentication
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# API Base URL
# Default: https://api.tinfoil.sh
NEXT_PUBLIC_API_BASE_URL=https://api.tinfoil.sh

# Optional: override the default harness origin, verified by the Tinfoil SDK.
NEXT_PUBLIC_HARNESS_ENCLAVE_URL=https://chat-api.tinfoil.sh

# Sandbox origin for HTML/JS previews (github.com/tinfoilsh/tinfoil-webapp-sandbox)
# Default: https://webapp-sandbox.tinfoil.sh. Vercel preview deployments must use
# https://tinfoil-webapp-sandbox-tinfoil.vercel.app, whose frame-ancestors admit *.vercel.app.
# Any other value must also be added to frame-src in vercel.json.
NEXT_PUBLIC_SANDBOX_ORIGIN=https://webapp-sandbox.tinfoil.sh
